{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "grpc_port": 9090,
    "tls_enabled": true,
    "cert_file": "/etc/ssl/certs/microvm-service.crt",
    "key_file": "/etc/ssl/private/microvm-service.key",
    "log_level": "info",
    "metrics_port": 8081
  },
  "firecracker": {
    "binary_path": "/usr/local/bin/firecracker",
    "kernel_image_path": "/var/lib/firecracker-containerd/runtime/default-vmlinux.bin",
    "root_drive_path": "/var/lib/firecracker-containerd/runtime/default-rootfs.img",
    "containerd_socket": "/run/firecracker-containerd/containerd.sock",
    "jailer_path": "/usr/local/bin/jailer",
    "chroot_base_dir": "/srv/jailer",
    "enable_jailer": true,
    "default_kernel_args": "console=ttyS0 noapic reboot=k panic=1 pci=off nomodules rw systemd.unified_cgroup_hierarchy=0 systemd.show_status=false quiet loglevel=1"
  },
  "networking": {
    "default_mode": "macvlan",
    "dhcp_config": {
      "enabled": true,
      "bridge_name": "fc-dhcp-br0",
      "dhcp_server_ip": "192.168.200.1",
      "dhcp_range": "192.168.200.10-192.168.200.100",
      "dns_servers": ["8.8.8.8", "8.8.4.4"],
      "mac_prefix": "AA:FC:00",
      "reservation_db": "/var/lib/microvm-service/dhcp-reservations.db"
    },
    "macvlan_config": {
      "enabled": true,
      "parent_interface": "eth0",
      "ip_range": "192.168.1.0/24",
      "gateway": "192.168.1.1",
      "dns_servers": ["8.8.8.8", "8.8.4.4"],
      "mac_prefix": "AA:FC:01"
    },
    "nat_config": {
      "enabled": false,
      "bridge_name": "fc-nat-br0",
      "subnet": "192.168.100.0/24",
      "gateway": "192.168.100.1",
      "dns_servers": ["8.8.8.8", "8.8.4.4"],
      "dhcp_enabled": true,
      "port_forward_base": 2200,
      "mac_prefix": "AA:FC:02"
    },
    "ovn_config": {
      "enabled": false,
      "ovs_bridge": "br-int",
      "logical_switch": "fc-ls",
      "logical_router": "fc-lr",
      "ovn_north_db_socket": "unix:/var/run/ovn/ovnnb_db.sock",
      "ovn_south_db_socket": "unix:/var/run/ovn/ovnsb_db.sock",
      "subnet_cidr": "192.168.150.0/24",
      "gateway_ip": "192.168.150.1",
      "dns_servers": ["8.8.8.8", "8.8.4.4"]
    }
  },
  "storage": {
    "default_type": "hybrid",
    "local_config": {
      "base_path": "/var/lib/firecracker-containerd/storage",
      "max_size_gb": 1000,
      "file_system": "ext4"
    },
    "s3_config": {
      "default_bucket": "microvm-storage-prod",
      "default_region": "us-east-1",
      "use_iam_role": true,
      "s3fs_mount_point": "/mnt/s3fs",
      "nbd_server_port": 10809
    },
    "hybrid_config": {
      "local_cache_path": "/var/cache/microvm-storage",
      "cache_size_gb": 100,
      "sync_interval_min": 5,
      "s3_bucket": "microvm-storage-prod",
      "s3_region": "us-east-1"
    }
  },
  "resources": {
    "buffer_percentage": 0.20,
    "max_vcpus_per_microvm": 16,
    "max_memory_mb_per_microvm": 65536,
    "max_storage_mb_per_microvm": 204800,
    "monitoring_interval_sec": 15,
    "overload_threshold": 0.75
  },
  "pricing": {
    "base_cpu_rate": 0.05,
    "base_memory_rate": 0.0001,
    "base_storage_rate": 0.00005,
    "profit_margin": 0.30,
    "update_interval_min": 5,
    "high_tier_discount": 0.40,
    "medium_tier_discount": 0.20,
    "low_tier_premium": 0.25,
    "currency": "USD"
  },
  "lxd": {
    "enabled": true,
    "socket": "/var/lib/lxd/unix.socket",
    "project_name": "default",
    "poll_interval_sec": 30
  },
  "development": {
    "simulate_lxd": false,
    "mock_resource_usage": false,
    "enable_debug_logging": false,
    "disable_auth": false
  }
}